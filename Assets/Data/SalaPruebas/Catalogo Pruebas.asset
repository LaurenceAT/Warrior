  - nombre: Sombra de los Humedales
    prefab: {fileID: 5833552481054790273, guid: 600cc38e3d7bee041962796af658f42e, type: 3}
    arena: 1
    titulo: La que duerme bajo el hielo
    config: {fileID: 11400000, guid: 62e275c49ee3b744eab376d25bf2e481, type: 2}
    marcaFase: 0
    barraPorFase: 1
    colorBarraFase2: {r: 0.25, g: 0.62, b: 0.95, a: 1}
    nombreFase2: "Sombra de los Humedales \u2014 Escarcha"
    luzFase2: {r: 0.62, g: 0.8, b: 1, a: 1}
    textoFase2: La sombra se alza de nuevo, envuelta en escarcha...
    particulasFase2A: {r: 1, g: 1, b: 1, a: 0.9}
    particulasFase2B: {r: 0.7, g: 0.9, b: 1, a: 0.7}
    particulasCaen: 1
    bannerVictoria: SOMBRA DISIPADA
    ajustesCazadora: {fileID: 0}
    vidaFase2: 0
    fichaDesafio: {fileID: 11400000, guid: bf7dd0b4b84bfd643924181a18529ff5, type: 2}
    asumeSueloPlano: 1
    avisoTerreno: 'La Sombra supone suelo plano: sus lanzas, estacas y escarcha salen
      a ras del suelo y no alcanzan las plataformas.'
