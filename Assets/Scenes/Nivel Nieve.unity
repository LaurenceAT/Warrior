  m_Script: {fileID: 11500000, guid: dcda5d9214c044c45922b83004040115, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  titulo: El guerrero congelado
  texto: "Un guerrero congelado a\xFAn empu\xF1a su espada. En su escudo, ara\xF1ado:
    \xABLa sombra teme la luz... pero cuando se alza de hielo, solo el fuego la quiebra.
    Y nunca, nunca dejes que te atrape: cuando se agache y brille en rojo, corre\xBB."
  id: estatua_7
  velocidadEscritura: 38
  radio: 1.4
  alturaAviso: 3.2
  brillo: 1
  colorBrillo: {r: 0.55, g: 0.88, b: 1, a: 1}
  intensidadBrillo: 0.45
  chispas: 0.8
