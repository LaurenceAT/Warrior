  prefabJefe: {fileID: 304753703972035695, guid: 600cc38e3d7bee041962796af658f42e, type: 3}
  nombre: Sombra de los Humedales
  titulo: La que duerme bajo el hielo
  zona:
    serializedVersion: 2
    x: 362.8
    y: 3
    width: 35
    height: 17
  suelo: 3
  burlas:
  - "\xABLa escarcha guarda tu \xFAltimo aliento.\xBB"
  - "\xABTe vi dudar. Las sombras nunca dudan.\xBB"
  - "\xABOtro guerrero congelado para mi pantano.\xBB"
  - "\xAB\xBFEsquivar? Ya estabas en mis garras.\xBB"
  - "\xABTu llama es d\xE9bil. La m\xEDa no se apaga.\xBB"
  - "\xABVuelve a la hoguera, peque\xF1o. Aqu\xED te espero.\xBB"
  - "\xABMi segunda piel es hielo. La tuya, carne.\xBB"
  - "\xABCada vez que caes, el invierno se alarga.\xBB"
  marcaFase: 0
  barraPorFase: 1
  colorBarraFase2: {r: 0.25, g: 0.62, b: 0.95, a: 1}
  nombreFase2: "Sombra de los Humedales \u2014 Escarcha"
