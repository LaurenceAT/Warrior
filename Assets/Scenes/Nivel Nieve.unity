  m_Script: {fileID: 11500000, guid: dcda5d9214c044c45922b83004040115, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  titulo: La sombra del claro
  texto: "Una sombra viva tapona la grieta de la roca. Los peregrinos la apartaban
    con luz: imbuye tu hoja con lo Sagrado (E) y golp\xE9ala. Hay sellos as\xED por
    toda la monta\xF1a. Cada uno teme a un elemento, y su color lo delata."
  id: estatua_claro
  velocidadEscritura: 38
  radio: 1.4
  alturaAviso: 3.2
  brillo: 1
  colorBrillo: {r: 0.55, g: 0.88, b: 1, a: 1}
  intensidadBrillo: 0.45
  chispas: 0.8
