  m_Script: {fileID: 11500000, guid: adcee8430c3cbe04ebe3718dfee891ab, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  frasesMuerte:
  - "El fr\xEDo no perdona a los que dudan."
  - "La nieve cubrir\xE1 tus huellas... y tu cuerpo."
  - "Lev\xE1ntate. La ventisca a\xFAn no ha terminado contigo."
  - "Algo en la bruma se r\xEDe de tu ca\xEDda."
  - "Hasta el hielo m\xE1s firme se quiebra. T\xFA tambi\xE9n."
  musica: {fileID: 8300000, guid: de5b8e683ab69034ca2ecf2561df5f55, type: 3}
  volumenMusica: 0.3
  ambiente: {fileID: 8300000, guid: 068a269db825447448d9ea8a539974b8, type: 3}
  volumenAmbiente: 0.35
  distanciaCombate: 12
  esperaFinCombate: 3
