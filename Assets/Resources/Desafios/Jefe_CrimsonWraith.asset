  m_Name: Jefe_CrimsonWraith
  m_EditorClassIdentifier: 
  id: crimson_wraith
  nombre: Crimson Wraith
  escena: Nivel Cueva
  orden: 1
  imagen: {fileID: 21300000, guid: e44b3befa9dc6704da7b24bcfd5cad5a, type: 3}
  afinidades:
  - elemento: 0
    multiplicador: 1.3
    cuando: Fase 1
    fase: 0
